# Optional public URL prefix for sneaker GLB/GLTF assets.
# Cloudinary: https://res.cloudinary.com/<cloud>/raw/upload/kixora/models
# Supabase: https://<project>.supabase.co/storage/v1/object/public/<bucket>
VITE_SNEAKER_MODEL_BASE_URL=

# Kixora environment contract for local QA and staged rollout.
# PayFast is the selected payment provider; The Courier Guy is the selected carrier.
# Keep local QA in mock mode and use sandbox credentials in staging.

# --- Client-side Variables (Prepend with VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE_CATALOG=false
VITE_USE_SUPABASE_DROPS=false
VITE_USE_SUPABASE_CART=false
VITE_USE_SUPABASE_WISHLIST=false
VITE_USE_SUPABASE_ORDERS=false
VITE_USE_SUPABASE_CHECKOUT=false
VITE_USE_SUPABASE_AUTH=false
VITE_USE_SUPABASE_ADMIN=false
VITE_USE_SUPABASE_ADMIN_CATALOG=false
VITE_USE_SUPABASE_ADMIN_ORDERS=false
VITE_USE_SUPABASE_ADMIN_INVENTORY=false
VITE_USE_SUPABASE_ADMIN_PROMOS=false
VITE_USE_SUPABASE_ADMIN_DROPS=false
VITE_USE_SUPABASE_ADMIN_AUDIT=false
VITE_PAYMENT_PROVIDER_MODE=mock
VITE_CUSTOMER_ORIGIN=http://127.0.0.1:3000
VITE_ADMIN_ORIGIN=http://admin.localhost:3000
VITE_CUSTOMER_DOMAIN=http://127.0.0.1:3000
VITE_ADMIN_DOMAIN=http://admin.localhost:3000
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=
VITE_PAYFAST_SANDBOX=true
VITE_CLOUDINARY_CLOUD_NAME=kixora
VITE_CLOUDINARY_UPLOAD_PRESET=kixora_product_images
VITE_CLOUDINARY_API_KEY=

# --- Server-side Secrets (NO VITE_ prefix) ---
PAYFAST_PASSPHRASE=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=Kixora Vault <orders@kixora.com>
THE_COURIER_GUY_API_KEY=
SHIPPING_WEBHOOK_SECRET=

# --- Phase A: Security Hardening ---
# CORS_ALLOWED_ORIGINS: Comma-separated list of explicit production origins.
# Must NOT be "*" in production and must not be empty.
# Local mock-safe defaults intentionally use localhost and admin.localhost.

# Standard AI Studio variables
GEMINI_API_KEY=
APP_URL=

# — SERVER-ENFORCED SECURITY BOUNDARIES —
# CUSTOMER_ORIGIN and ADMIN_ORIGIN MUST be distinct HTTPS origins in production.
# Both MUST also appear inside CORS_ALLOWED_ORIGINS.
CUSTOMER_ORIGIN=http://127.0.0.1:3000
ADMIN_ORIGIN=http://admin.localhost:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://admin.localhost:3000
