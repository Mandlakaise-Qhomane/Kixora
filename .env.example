# ==============================================================================
# KIXORA ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# CLIENT-SAFE VARIABLES (Must be prefixed with VITE_)
# These are exposed to the browser bundle.
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE_CATALOG=true
VITE_PAYMENT_PROVIDER_MODE=mock
VITE_PAYMENT_PUBLIC_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=
VITE_PAYFAST_SANDBOX=true
VITE_CUSTOMER_DOMAIN=https://kixora.com
VITE_ADMIN_DOMAIN=https://admin.kixora.com
VITE_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (Do NOT prefix with VITE_)
# These MUST NEVER be exposed to the browser.
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYFAST_PASSPHRASE=
SUPABASE_SERVICE_ROLE_KEY=
