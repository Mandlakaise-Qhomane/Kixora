# Kixora Environment Variables
# For more info see src/config/env.ts

# --- Client-side Variables (Prepend with VITE_) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_USE_SUPABASE_CATALOG=true
VITE_PAYMENT_PROVIDER_MODE=payfast
VITE_CUSTOMER_ORIGIN=https://kixora-staging.vercel.app
VITE_ADMIN_ORIGIN=https://kixora-staging.vercel.app
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=
VITE_PAYFAST_SANDBOX=true
VITE_CLOUDINARY_CLOUD_NAME=kixora
VITE_CLOUDINARY_UPLOAD_PRESET=kixora_product_images
VITE_CLOUDINARY_API_KEY=

# --- Server-side Secrets (NO VITE_ prefix) ---
PAYFAST_PASSPHRASE=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=Kixora Vault <orders@kixora.com>
THE_COURIER_GUY_API_KEY=
SHIPLOGIC_API_KEY=
SHIPPING_WEBHOOK_SECRET=

# --- Phase A: Security Hardening ---
# CORS_ALLOWED_ORIGINS: Comma-separated list of explicit production origins.
# Must NOT be "*" in production and must not be empty.
CORS_ALLOWED_ORIGINS=https://kixora-staging.vercel.app

# --- Phase 2: Deployment & Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
CLOUD_RUN_PROJECT_ID=
CLOUD_RUN_REGION=africa-southeast1
CLOUD_RUN_SERVICE_STAGING=kixora-staging
CLOUD_RUN_SERVICE_PRODUCTION=kixora-production
ARTIFACT_REGISTRY_REPOSITORY=kixora

# Standard AI Studio variables
GEMINI_API_KEY=
APP_URL=

# Server origin boundary. In production these must be distinct HTTPS origins
# and both must be included in CORS_ALLOWED_ORIGINS.
CUSTOMER_ORIGIN=https://kixora.com
ADMIN_ORIGIN=https://admin.kixora.com
CORS_ALLOWED_ORIGINS=https://kixora.com,https://admin.kixora.com
